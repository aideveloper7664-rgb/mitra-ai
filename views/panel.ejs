<!DOCTYPE html>
<html>
<head>
    <title>Mitra AI - Panel</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🤖 Mitra AI Panel</h1>
            <a href="/logout" class="logout">Logout</a>
        </header>

        <nav class="tabs">
            <button class="tab active" data-tab="dashboard">Dashboard</button>
            <button class="tab" data-tab="whatsapp">WhatsApp</button>
            <button class="tab" data-tab="ai-keys">AI Keys</button>
            <button class="tab" data-tab="imgbb-keys">ImgBB Keys</button>
            <button class="tab" data-tab="instructions">Instructions</button>
            <button class="tab" data-tab="knowledge">Knowledge</button>
            <button class="tab" data-tab="chats">Chats</button>
        </nav>

        <!-- Dashboard -->
        <section id="dashboard" class="tab-content active">
            <div class="card">
                <h2>Bot Status</h2>
                <div class="status-row">
                    <span>Bot:</span>
                    <span id="bot-status" class="status-badge">Loading...</span>
                    <button id="toggle-bot" class="btn">Toggle</button>
                </div>
                <div class="stats">
                    <div class="stat"><h3 id="ai-count">0</h3><p>AI Keys</p></div>
                    <div class="stat"><h3 id="ai-active">0</h3><p>AI Active</p></div>
                    <div class="stat"><h3 id="imgbb-count">0</h3><p>ImgBB Keys</p></div>
                    <div class="stat"><h3 id="imgbb-active">0</h3><p>ImgBB Active</p></div>
                </div>
            </div>
        </section>

        <!-- WhatsApp Connect -->
        <section id="whatsapp" class="tab-content">
            <div class="card">
                <h2>WhatsApp Connect</h2>

                <div id="wa-connected" style="display:none;">
                    <div style="background:#065f46; padding:16px; border-radius:8px; margin-bottom:16px;">
                        <p style="color:#6ee7b7; margin:0;">✅ WhatsApp connected</p>
                        <p id="wa-connected-number" style="color:#94a3b8; margin:4px 0 0 0; font-size:14px;"></p>
                    </div>
                    <button onclick="disconnectWhatsApp()" class="btn btn-danger">Disconnect</button>
                </div>

                <div id="wa-not-connected">
                    <p style="color:#94a3b8; margin-bottom:20px;">
                        WhatsApp connect karne ke liye 2 options hain:
                    </p>

                    <div class="wa-options">
                        <!-- Option 1: QR Code -->
                        <div class="wa-option">
                            <h3>📷 QR Code Se</h3>
                            <p>QR scan karo WhatsApp se</p>
                            <button onclick="showQR()" class="btn">Show QR</button>
                            <div id="wa-qr-container" style="margin-top:16px;"></div>
                        </div>

                        <!-- Option 2: Pairing Code -->
                        <div class="wa-option">
                            <h3>🔢 Pairing Code Se</h3>
                            <p>Country code select karo, number daalo</p>
                            <div class="form-row" style="margin-top:12px;">
                                <select id="wa-country" style="flex: 0 0 160px;">
                                    <option value="977">🇳🇵 Nepal (+977)</option>
                                    <option value="91">🇮🇳 India (+91)</option>
                                    <option value="92">🇵🇰 Pakistan (+92)</option>
                                    <option value="880">🇧🇩 Bangladesh (+880)</option>
                                </select>
                                <input id="wa-phone" placeholder="Phone number" style="flex: 1;">
                            </div>
                            <button onclick="requestPairingCode()" class="btn" style="margin-top:12px;">Get Pairing Code</button>
                            <div id="wa-pairing-container" style="margin-top:16px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- AI Keys -->
        <section id="ai-keys" class="tab-content">
            <div class="card">
                <h2>AI Keys</h2>
                <div class="form-row">
                    <select id="ai-provider">
                        <option value="gemini">Gemini</option>
                        <option value="groq">Groq</option>
                        <option value="openrouter">OpenRouter</option>
                        <option value="openai">OpenAI</option>
                        <option value="mistral">Mistral</option>
                    </select>
                    <input id="ai-label" placeholder="Label (jaise Gemini-1)">
                    <input id="ai-key" placeholder="API Key">
                    <input id="ai-model" placeholder="Model (optional)">
                    <button onclick="addAIKey()" class="btn">Add</button>
                </div>
                <div id="ai-keys-list" class="list"></div>
            </div>
        </section>

        <!-- ImgBB Keys -->
        <section id="imgbb-keys" class="tab-content">
            <div class="card">
                <h2>ImgBB Keys</h2>
                <div class="form-row">
                    <input id="imgbb-label" placeholder="Label">
                    <input id="imgbb-key" placeholder="API Key">
                    <button onclick="addImgBBKey()" class="btn">Add</button>
                </div>
                <div id="imgbb-keys-list" class="list"></div>
            </div>
        </section>

        <!-- Instructions -->
        <section id="instructions" class="tab-content">
            <div class="card">
                <h2>Custom Instructions</h2>
                <div class="form-row">
                    <input id="instr-text" placeholder="Instruction likho..." style="flex:1">
                    <button onclick="addInstruction()" class="btn">Add</button>
                </div>
                <div id="instructions-list" class="list"></div>
            </div>
        </section>

        <!-- Knowledge -->
        <section id="knowledge" class="tab-content">
            <div class="card">
                <h2>Knowledge Base</h2>
                <div class="form-col">
                    <label>Assistant Name <input id="k-assistantName"></label>
                    <label>Sir Name <input id="k-sirName"></label>
                    <label>Sir Intro <input id="k-sirIntro"></label>
                    <label>YouTube <input id="k-youtube"></label>
                    <label>Telegram <input id="k-telegram"></label>
                    <label>Website <input id="k-website"></label>
                    <label>App <input id="k-app"></label>
                    <label>Busy Message <input id="k-busyMessage"></label>
                    <label>Note <input id="k-note"></label>
                    <button onclick="saveKnowledge()" class="btn">Save</button>
                </div>
            </div>
        </section>

        <!-- Chats -->
        <section id="chats" class="tab-content">
            <div class="card">
                <h2>Users & Chats</h2>
                <div id="users-list" class="list"></div>
                <div id="user-messages" class="messages"></div>
            </div>
        </section>
    </div>

    <script src="/script.js"></script>
</body>
</html>
